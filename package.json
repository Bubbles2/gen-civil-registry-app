{
  "name": "gen-civil-registry-app",
  "version": "1.1.4",
  "private": true,
  "scripts": {
    "android:dev": "npx react-native run-android --mode devDebug --appIdSuffix dev --port 3000",
    "android": "npx react-native run-android",
    "ios": "npx react-native run-ios",
    "start": "npx react-native start --port 3000 --experimental-debugger",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build-file-dev": "node src/buildFile/build-file-dev.mjs",
    "build-file-preprod": "node src/buildFile/build-file-preprod.mjs",
    "build-file-prod": "node src/buildFile/build-file-prod.mjs",
    "build-file-qua": "node src/buildFile/build-file-qua.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@op-engineering/op-sqlite": "14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.0.1",
    "@react-navigation/native": "^7.1.34",
    "@react-navigation/native-stack": "^7.19.2",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.20.0",
    "bcrypt-react-native": "1.1.1",
    "flat": "^6.0.1",
    "i18next": "^25.10.10",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "log4js": "^6.9.1",
    "moment": "^2.29.4",
    "papaparse": "^5.7.0",
    "prop-types": "^15.8.1",
    "react": "19.0.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^15.7.4",
    "react-native": "0.78.3",
